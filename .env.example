# Required by the Telegram receiver at runtime.
# Generate a Telegram-compatible secret token (1–256 chars: A–Z, a–z, 0–9, _ or -).
TELEGRAM_WEBHOOK_SECRET=

# Numeric Telegram group/supergroup chat_id. Receiver accepts only this chat.
TELEGRAM_ALLOWED_CHAT_ID=

# The bot token is needed only by the operator when registering the webhook with Telegram.
# Keep the existing token in the production secret manager; never commit it here.
TELEGRAM_BOT_TOKEN=
