# Required by the Telegram receiver at runtime.
# Generate a Telegram-compatible secret token (1–256 chars: A–Z, a–z, 0–9, _ or -).
TELEGRAM_WEBHOOK_SECRET=

# Numeric Telegram group/supergroup chat ID(s) explicitly approved for intake.
# Keep only the user's controlled upload group in this allowlist.
TELEGRAM_ALLOWED_CHAT_IDS=

# Server-side only: needed for webhook registration and, in the ingestion worker, Telegram getFile downloads.
# Keep it in the production secret manager; never commit it here.
TELEGRAM_BOT_TOKEN=

# Optional Vercel safety proxy; Telegram should target the Worker directly after staging tests.
TELEGRAM_INGESTION_URL=https://thuthayatethar-telegram-ingestion.<account>.workers.dev/telegram/webhook

# Public catalog endpoint exposed by the Cloudflare Worker.
# Keep this as a server-side URL; app/api/catalog proxies it to the browser.
CATALOG_API_URL=https://thuthayatethar-telegram-ingestion.<account>.workers.dev/catalog
