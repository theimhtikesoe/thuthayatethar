{
  "name": "thutayote",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "prestart": "node scripts/copy-pdf-worker.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:reader-navigation": "node --test app/reader-navigation.test.mjs",
    "test:catalog": "node --experimental-strip-types --test app/catalog-grouping.test.mjs app/audiobook-grouping.test.mjs app/admin-slug.test.mjs app/audio-progress.test.mjs app/burmese-text.test.mjs app/offline-storage.test.mjs",
    "test:ingestion": "node --experimental-strip-types --test infra/cloudflare/test/worker.test.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "pdfjs-dist": "3.11.174",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pageflip": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.2"
  }
}
